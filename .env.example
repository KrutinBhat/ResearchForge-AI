# GEMINI_API_KEY: Required for server-side Gemini AI generation & optional critique calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Cryptographically strong signing key for session JWTs in production.
JWT_SECRET="replace-with-strong-random-secret"

# APP_URL: Hosted application URL.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL connection parameters (used by both Node adapter and FastAPI/Alembic)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Canonical FastAPI Backend URL (optional in Node adapter; if set, Express proxies /api/* to FastAPI)
FASTAPI_URL=""

# Durable Background Processing (Celery + Redis)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Optional Local LLM Inference
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Demo workspace gate (automatically disabled when NODE_ENV/ENVIRONMENT=production)
ENABLE_DEMO_WORKSPACE="true"
